page {
  min-height: 100%;
  background: #f3f5ef;
  color: #20352b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

view, text, input, picker, slider, button {
  box-sizing: border-box;
}

button::after { border: 0; }

